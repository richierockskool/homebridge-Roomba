{
  "name": "homebridge-roomba-pro",
  "displayName": "Roomba Pro",
  "type": "module",
  "version": "0.1.1",
  "description": "A reliable Homebridge plugin for controlling supported iRobot Roomba robot vacuums in Apple Home.",
  "author": "Jagger Hannah",
  "license": "Apache-2.0",
  "homepage": "https://github.com/richierockskool/homebridge-Roomba#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/richierockskool/homebridge-Roomba.git"
  },
  "bugs": {
    "url": "https://github.com/richierockskool/homebridge-Roomba/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "roomba",
    "irobot",
    "vacuum",
    "robot-vacuum",
    "homekit"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "aws-iot-device-sdk-v2": "^1.28.0",
    "homebridge-lib": "^8.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
